+/**
+ * Generate a cryptographically secure random hash (VULN-02).
+ * Used for password-reset / set-password tokens (new_pass_key); must be unpredictable.
+ * @return string 64-char hex
+ */
+function app_generate_hash()
+{
+    try {
+        return bin2hex(random_bytes(32));
+    } catch (Exception $e) {
+        return bin2hex(openssl_random_pseudo_bytes(32));
+    }
+}
